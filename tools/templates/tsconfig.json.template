{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "noUncheckedSideEffectImports": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "paths": { "canvas-editor/tokens": ["{{tokens}}"] }
  },
  "include": ["screens", "packs", "canvas.config.ts"],
  "exclude": ["**/*.test.ts", "packs/*/library/tokens.ts"]
}
