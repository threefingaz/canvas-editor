{
  "name": "canvas-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "canvas": "bin/canvas.js"
  },
  "exports": {
    "./tokens": "./src/tokens/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "tools",
    "guide",
    "public",
    "index.html",
    "frame.html",
    "site.html",
    "vite.config.ts",
    "canvas.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "AGENTS.md",
    "!**/*.test.ts"
  ],
  "workspaces": [
    "packs/*"
  ],
  "scripts": {
    "dev": "node bin/canvas.js dev",
    "build": "node bin/canvas.js build",
    "lint": "oxlint",
    "preview": "node bin/canvas.js preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node bin/canvas.js tokens",
    "check": "node bin/canvas.js check",
    "status": "node bin/canvas.js status",
    "init": "node bin/canvas.js init",
    "sync": "node bin/canvas.js sync",
    "agents": "node bin/canvas.js agents",
    "export": "node bin/canvas.js export"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "magic-string": "^1.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "vitest": "^5.1.0"
  }
}
